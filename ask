#!/usr/bin/env bash
# ask - send prompt to an OpenAI-compatible LLM API
# Usage: accepts a prompt or regular input
# Dependencies: curl, jq

set -euo pipefail


# look for required environment variables

if [[ -z "${ASK_API_URL:-}" ]]; then
  echo "Error: ASK_API_URL is not set." >&2
  echo "  Example: export ASK_API_URL=https://api.groq.com/openai/v1/chat/completions" >&2
  exit 1
fi

if [[ -z "${ASK_MODEL:-}" ]]; then
  echo "Error: ASK_MODEL is not set." >&2
  echo "  Example: export ASK_MODEL=llama-3.3-70b-versatile" >&2
  exit 1
fi

if [[ -z "${ASK_API_KEY:-}" ]]; then
  echo "Error: ASK_API_KEY is not set." >&2
  echo "  Example: export ASK_API_KEY=your_api_key_here" >&2
  exit 1
fi

# create user prompt game plan:
#   1. command-line args are all joined into 1 string.
#   2. stdin is piped (?), text appended.
#   3. neither is provided (?) show usage and exit.

# all positional arguments joined with a space

args_prompt="${*}"

# look if stdin has piped data 

piped_input=""
if [[ ! -t 0 ]]; then
  piped_input="$(cat)"
fi

# Combine args 1st, 2nd piped input 

if [[ -n "$args_prompt" && -n "$piped_input" ]]; then
  user_prompt="${args_prompt} ${piped_input}"
elif [[ -n "$args_prompt" ]]; then
  user_prompt="$args_prompt"
elif [[ -n "$piped_input" ]]; then
  user_prompt="$piped_input"
else
  echo "Usage: ask [prompt...]" >&2
  echo "       echo 'text' | ask [optional prefix...]" >&2
  echo "" >&2
  echo "Environment variables required:" >&2
  echo "  ASK_API_URL   - Full URL to the chat completions endpoint" >&2
  echo "  ASK_MODEL     - Model name to use (e.g. llama-3.3-70b-versatile)" >&2
  echo "  ASK_API_KEY   - Your API key" >&2
  exit 1
fi

# Build, send the API request

# jq used for safely constructing JSON payload.
# avoids any quoting or escaping issues 
request_body="$(jq -n \
  --arg model "$ASK_MODEL" \
  --arg user_content "$user_prompt" \
  '{
    model: $model,
    messages: [
      {
        role: "system",
        content: "You are a CLI tool. Output plain text only. No yapping. Keep the output concise."
      },
      {
        role: "user",
        content: $user_content
      }
    ]
  }')"

# request sent with curl
response="$(curl -s \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer $ASK_API_KEY" \
  -d "$request_body" \
  "$ASK_API_URL")"

# Parse then print the response

# Check if response contains error field
error_msg="$(echo "$response" | jq -r '.error.message // empty' 2>/dev/null)"
if [[ -n "$error_msg" ]]; then
  echo "API Error: $error_msg" >&2
  exit 1
fi

# Extract reply text
output="$(echo "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null)"

if [[ -z "$output" ]]; then
  echo "Error: Could not parse response from API." >&2
  echo "Raw response: $response" >&2
  exit 1
fi

echo "$output"
